--postgresql.conf 中设置这些参数

listen_addresses = '*'
max_wal_senders =10
wal_level = replica
wal_log_hints = on
log_connections = on
wal_receiver_status_interval = 2s
hot_standby_feedback = on

--配置之后重新启动服务：

启动服务
pg_ctl start -l /usr/local/postgresql/log/pg_server.log

关闭服务
pg_ctl stop -l /usr/local/postgresql/log/pg_server.log

重启服务
pg_ctl restart -l /usr/local/postgresql/log/pg_server.log