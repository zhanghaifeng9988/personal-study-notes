set concat off
create table ZFS_OP.corrupted_lob_data (corrupted_rowid rowid,err_num number); 
set concat off
declare  
  error_1555 exception;  
  pragma exception_init(error_1555,-1555); 
  error_22924 exception;  
  pragma exception_init(error_22924,-22924);  
  num number;  
begin  
  for cursor_lob in (select rowid r, &&lob_column from &table_owner.&table_with_lob) loop  
    begin  
      num := dbms_lob.instr (cursor_lob.FILE_BASE64, hextoraw ('889911')) ;  
    exception  
      when error_1555 then  
        insert into ZFS_OP.corrupted_lob_data values (cursor_lob.r,01555);  
        commit;  
      when error_22924 then
        insert into ZFS_OP.corrupted_lob_data values (cursor_lob.r,22924);  
        commit;   
    end;  
  end loop;  
end; 
/

