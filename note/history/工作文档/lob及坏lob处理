 --OP_INVOICE_IMAGE_RELATION

select (
(select sum(s.bytes) from dba_segments s 
where s.owner='ZFS_OP' and
(s.segment_name='OP_INVOICE_IMAGE_RELATION')) + (select sum(s.bytes)
from dba_segments s, dba_lobs l
where s.owner='ZFS_OP' and
(l.segment_name=s.segment_name and l.table_name='OP_INVOICE_IMAGE_RELATION' and l.owner='ZFS_OP')) +(select sum(s.bytes)
from dba_segments s,dba_indexes i 
where s.owner='ZFS_OP' and 
(i.index_name=s.segment_name and i.table_name='OP_INVOICE_IMAGE_RELATION' and index_type='LOB' 
and i.owner='ZFS_OP')) )/1024/1024/1024 as "TOTAL_TABLE_SIZE_G" from dual;

