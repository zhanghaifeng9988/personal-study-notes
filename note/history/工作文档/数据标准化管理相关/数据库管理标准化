col TABLESPACE_NAME for a20
col name for a10
set line 200 pages 999
select TABLESPACE_NAME,round(USED_SPACE*8/1024/1024, 2) AS "USED-G",
round(TABLESPACE_SIZE*8/1024/1024, 2) AS "SIZE-G",round((TABLESPACE_SIZE-USED_SPACE)*8/1024/1024, 2) "FREE-G",
to_char(USED_PERCENT,'00.00') as "USED_PERCENT"  
from dba_tablespace_usage_metrics  where TABLESPACE_NAME in('SYSAUX','SYSTEM','UNDO%','TEMP')
order by used_percent desc ;


--19c容器库undo情况查询
select tablespace_name,extent_management,allocation_type,con_id,BLOCK_SIZE,round(max_size/1024/1024,2) AS "USED-G"
from cdb_tablespaces 
where tablespace_name like 'UNDO%';

--19c容器库pdb和CDB的undo大小查询
