--普通参数查询

  show parameter db_files                         数据库实例参数信息
  show parameter log_archive_dest_1               归档日志的路径信息
  show parameter recyclebin                       回收站的状态信息
  show parameter audit_trail                      审计跟踪相关
  show parameter process                          oracle的process参数
  show parameter undo_retention                   undo保留时间
  show parameter open_cursors                     打开游标参数
  show parameter session_cached_cursors           会话缓存游标参数
  show parameter memory_target                    内存目标参数
  show parameter parallel_force_local            并行参数
  
  set line 200 pages 999 long 20000
  col name for a25
  col VALUE for a30 
  select name,value from v$parameter where name in ('db_files',
'log_archive_dest_1','recyclebin','audit_trail','processes','undo_retention','open_cursors',
'session_cached_cursors','memory_target','parallel_force_local') order by name;
  
  
--隐含参数查询：
  set line 200 pages 999 long 20000
 col  PARAMETER for a30 
 col  DESCRIPTION for a30
 col  SESSION_VALUE for a10
 col  INSTANCE_VALUE for a20
select a.ksppinm parameter,a.ksppdesc description,
b.ksppstvl session_value,c.ksppstvl session_value,
c.ksppstvl instance_value 
from x$ksppi a,x$ksppcv b,x$ksppsv c
where a.indx=b.indx
and a.indx=c.indx
and a.ksppinm in ('_optimizer_extended_cursor_sharing','_optimizer_extended_cursor_sharing_rel',
'_serial_direct_read','_bloom_filter_enabled','_bloom_pruning_enabled',
'_gc_defer_time','_PX_use_large_pool','_lm_tickets','_b_tree_bitmap_plans',
'_use_adaptive_log_file_sync','_gc_read_mostly_locking',
'_gc_undo_affinity')
order by a.ksppinm;  
  
