select 'alter table '||table_owner||'.'||table_name||' move partition '||partition_name||' tablespace FKDATA nologging parallel 8;',partition_name,tablespace_name
from dba_tab_partitions where table_owner='CACHER01' and tablespace_name='DATA_A' and table_name='C_PS'

  重建普通索引
select 'alter index ' ||OWNER || '.' || index_name || ' REBUILD  parallel 8 nologging;' ,TABLESPACE_NAME,STATUS from dba_indexes where 
owner='CACHER01' and table_name='C_PS'
  --重建分区索引
select 'alter index '||t.INDEX_OWNER||'.'||t.INDEX_NAME||'  rebuild partition ' || t.PARTITION_NAME || ' parallel 8 nologging tablespace IDXCACHE ;' , STATUS
 from dba_ind_partitions t where INDEX_OWNER='CACHER01' and STATUS='UNUSABLE'  AND INDEX_NAME='SYS_IL0000488971C00017$$';
  
   
--subpartiton
  --移动子分区表
select 'alter table '||table_owner||'.'||table_name||' move subpartition '||subpartition_name||' tablespace FKDATA nologging parallel 8 ;',partition_name,tablespace_name
from dba_tab_subpartitions where table_owner='CACHER07'  and tablespace_name='DATA_A' and table_name='E_TMNL_DAY_STAT'
  
  --重建普通索引
select 'alter index ' ||OWNER || '.' || index_name || ' REBUILD  parallel 8 nologging;' ,TABLESPACE_NAME,STATUS
from dba_indexes where  owner='CACHER07' and table_name='E_TMNL_DAY_STAT'
  --重建分区索引
select 'alter index '||t.INDEX_OWNER||'.'||t.INDEX_NAME||'  rebuild partition ' || t.PARTITION_NAME || ' parallel 8 nologging tablespace IDXCACHE ;' , STATUS
 from dba_ind_partitions t where INDEX_OWNER='CACHER01' and STATUS='UNUSABLE' ;
  --重建子分区索引
select 'alter index '||t.INDEX_OWNER||'.'||t.INDEX_NAME||'  rebuild subpartition ' || t.SUBPARTITION_NAME ||  ' parallel 8 nologging tablespace IDXCACHE ;' , STATUS
from dba_ind_subpartitions t where INDEX_OWNER='CACHER01' and STATUS='UNUSABLE' ;


