--转移分区表并压缩表的语句
select 'alter table '||table_owner||'.'||table_name||' move subpartition '||subpartition_name||' 
tablespace HISCMPRS01 nologging parallel 8 compress;',compression,partition_name,subpartition_name,tablespace_name
from dba_tab_subpartitions 
where table_owner='FDPSHARE' and table_name='ARC_E_MP_PQ' and  partition_name='P14401' and subpartition_name<'P14401_P202201';																	  



--查询失效索引
col owner for a20
col status for a20
col index_name for a30
select owner,index_name,status from dba_indexes 
where STATUS='UNUSABLE' and  owner='FDPSHARE' and table_name='ARC_E_MP_PQ';


--重建普通索引
  alter index FDPSHARE.PK_ARC_E_MP_PQ rebuild parallel 12  nologging;

--重建子分区索引
  select 'alter index '||t.INDEX_OWNER||'.'||t.INDEX_NAME||'  rebuild subpartition ' || t.SUBPARTITION_NAME ||  ' parallel 8 nologging tablespace IDXCACHE ;' , STATUS,tablespace_name
from dba_ind_subpartitions t where INDEX_OWNER='FDPSHARE' and STATUS='UNUSABLE' and INDEX_NAME='INDEX_NAME';




















