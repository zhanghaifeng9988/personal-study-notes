SQL> --查询索引大小(已经在索引表空间了,不需要移动表空间)
SQL> col INDEX_NAME for a30
SQL> col DEGREE for a5
SQL> col tablespace_name for a30
SQL> col status for a10
SQL> set lines 200 pages 999 long 20000
SQL> select index_name,degree,status,tablespace_name 
from dba_indexes 
where owner='CACHER01' and table_name='A_PC_TRAN';

INDEX_NAME                     DEGRE STATUS     TABLESPACE_NAME
------------------------------ ----- ---------- ------------------------------
PK_A_PC_TRAN                   1     VALID      IDXCACHE


SQL> col OWNER for a20
SQL> col SEGMENT_NAME for a30
SQL> col SEGMENT_TYPE for a20
SQL> set lines 200 pages 999 long 20000
SQL> select  OWNER,SEGMENT_NAME,SEGMENT_TYPE,sum(BYTES)/1024/1024/1024 
from dba_segments
where segment_name in ('PK_A_PC_TRAN') and owner='CACHER01'
group by OWNER,SEGMENT_NAME,SEGMENT_TYPE order by sum(BYTES);

OWNER                SEGMENT_NAME                   SEGMENT_TYPE         SUM(BYTES)/1024/1024/1024
-------------------- ------------------------------ -------------------- -------------------------
CACHER01             PK_A_PC_TRAN                   INDEX                              12.85546875


SQL> --查看分区信息(plsql执行)
SQL> select * from dba_tab_partitions where  table_owner='CACHER01'  and TABLE_NAME='A_PC_TRAN';


SQL> --查询小于2022年数据量

SQL> select sum(bytes)/1024/1024/1024 from dba_segments where owner='CACHER01' and segment_name='A_PC_TRAN' and partition_name in 
(select partition_name from dba_tab_partitions where table_owner='CACHER01' and table_name='A_PC_TRAN' and  partition_name<'P202201');

SUM(BYTES)/1024/1024/1024
-------------------------
68.0302734

SQL> --转移分区表并压缩表的语句
SQL> select 'alter table '||table_owner||'.'||table_name||' move partition '||partition_name||' 
tablespace HISCMPRS01 nologging parallel 8 compress;',compression,partition_name 
from dba_tab_partitions 
where table_owner='CACHER01' and table_name='A_PC_TRAN' and partition_name<'P202201';

