


SQL> --查询表的大小
SQL> col OWNER for a20
SQL> col SEGMENT_NAME for a30
SQL> col SEGMENT_TYPE for a30
SQL> col tablespace_name for a20
SQL> set lines 200 pages 999 long 20000
SQL> select  OWNER,SEGMENT_NAME,SEGMENT_TYPE,tablespace_name ,sum(BYTES)/1024/1024/1024 
from dba_segments
where segment_name='A_PC_TRAN' and owner='CACHER01'
group by OWNER,SEGMENT_NAME,SEGMENT_TYPE,tablespace_name order by sum(BYTES);

OWNER                SEGMENT_NAME                   SEGMENT_TYPE                   TABLESPACE_NAME      SUM(BYTES)/1024/1024/1024
-------------------- ------------------------------ ------------------------------ -------------------- -------------------------
CACHER01             A_PC_TRAN                      TABLE PARTITION                CACHEDATA                          114.1943359


SQL> --查看分区表统计信息
SQL> col OWNER for a20
SQL> col TABLE_NAME for a30
SQL> set lines 200 pages 999 long 20000
SQL> select OWNER,TABLE_NAME,PARTITIONING_TYPE,SUBPARTITIONING_TYPE,PARTITION_COUNT
from dba_part_tables
where OWNER='CACHER01' and TABLE_NAME='A_PC_TRAN';

OWNER                TABLE_NAME                     PARTITIONING_TYPE           SUBPARTITIONING_TYPE        PARTITION_COUNT
-------------------- ------------------------------ --------------------------- --------------------------- ---------------
CACHER01             A_PC_TRAN                      RANGE                       NONE                                    168


