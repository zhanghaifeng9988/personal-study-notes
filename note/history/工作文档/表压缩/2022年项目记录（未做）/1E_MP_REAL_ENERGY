

--查询表空间中所含数据段的情况
col OWNER for a20
col SEGMENT_NAME for a30
col SEGMENT_TYPE for a30
col tablespace_name for a20
set lines 200 pages 999 long 20000
select  OWNER,SEGMENT_NAME,SEGMENT_TYPE,tablespace_name ,sum(BYTES)/1024/1024/1024 
from dba_segments
where TABLESPACE_NAME='DATA_A' 
group by OWNER,SEGMENT_NAME,SEGMENT_TYPE,tablespace_name order by sum(BYTES);



