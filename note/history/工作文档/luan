长事务的查询

set line 200 pages 999 long 20000
col transaction_duration for a30
col USERNAME for a30
col  PROGRAM for a20
col TERMINAL for a15
col STATUS for a13
col SID for a8

 with transaction_details as
(select inst_id,ses_addr,sysdate -  start_date as diff
from gv$transaction)
select s.username,to_char(trunc(t.diff))
|| ' days, '|| to_char(trunc(mod(t.diff*24,24)))
|| ' hours, '
|| to_char(trunc(mod(t.diff*24*60,24)))
|| ' minutes, '
|| to_char(trunc(mod(t.diff*24*60*60,60)))
|| ' seconds' as transaction_duration
,s.program,s.terminal,s.status,s.sid,s.serial#
from gv$session s  ,transaction_details t
where s.inst_id=t.inst_id and s.saddr=t.ses_addr
order by  t.diff desc;

select xidusn,xidslot,xidsqn from v$transaction;


