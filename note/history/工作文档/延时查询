


col INDEX_NAME for a30
col DEGREE for a5
col tablespace_name for a30
col status for a10
set lines 200 pages 999 long 20000
select index_name,degree,status,tablespace_name 
from dba_indexes 
where owner='GRIDVIEW' and table_name='A_LINGTU_QF';


col OWNER for a20
col SEGMENT_NAME for a30
col SEGMENT_TYPE for a30
col tablespace_name for a20
set lines 200 pages 999 long 20000
select  OWNER,SEGMENT_NAME,SEGMENT_TYPE,tablespace_name ,sum(BYTES)/1024/1024/1024 
from dba_segments
where segment_name='A_OCS_RECO_POWEROFF' and owner='GRIDVIEW'
group by OWNER,SEGMENT_NAME,SEGMENT_TYPE,tablespace_name;


select  OWNER,SEGMENT_NAME,SEGMENT_TYPE,tablespace_name ,sum(BYTES)/1024/1024/1024 
