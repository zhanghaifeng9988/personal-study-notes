

--查询正在运行的sql
SELECT b.sid oracleID,
	b.username,
	b.serial#,
	spid,
	paddr,
	sql_text,
	b.machine,
	c.hash_value,
	c.sql_id
FROM v$session b
LEFT JOIN v$process a ON a.addr = b.paddr
LEFT JOIN v$sqlarea c ON b.sql_hash_value = c.hash_value
WHERE sql_text IS NOT NULL;

--杀死sql
ALTER system KILL SESSION '{ORACLEID},{SERIAL#}'  immediate;


