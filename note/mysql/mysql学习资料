安装mysql，并记住初始化随机密码
cd /usr/local/mysql/bin
[root@oggtarget bin]# ./mysqld --initialize  --console
root@localhost: Xr%v%j7o?x>?    这是初始密码

启动mysql
cd /usr/local/mysql/support-files
[root@oggtarget support-files]# ./mysql.server start
Starting MySQL.Logging to '/usr/local/mysql/mysqldb/oggtarget.err'.
 ERROR! The server quit without updating PID file (/usr/local/mysql/mysqldb/oggtarget.pid).

赋权，重新启动
chmod -R 777 /usr/local/mysql
[root@oggtarget support-files]# ./mysql.server start
Starting MySQL.. SUCCESS!
将mysql添加到系统进程中
 cp /usr/local/mysql/support-files/mysql.server /etc/init.d/mysqld

设置mysql随操作系统自动启动
chmod +x /etc/init.d/mysqld  
systemctl enable mysqld.service

配置环境变量
[root@oggtarget bin]# vi /etc/profile
添加：export PATH=$PATH:/usr/local/mysql/bin/
[root@oggtarget bin]# source /etc/profile  
[root@oggtarget bin]# mysql -u root -p     --密码为初始密码

修改root用户初始密码
mysql>  alter user 'root'@'localhost' IDENTIFIED WITH mysql_native_password BY 'mysql';
Query OK, 0 rows affected (0.01 sec)

设置允许远程登陆
mysql> use mysql
mysql> update user set user.Host='%'where user.User='root';
重启mysql
[root@oggtarget support-files]# ./mysql.server restart
Shutting down MySQL.. SUCCESS!
Starting MySQL.. SUCCESS!

数据库关闭的两种方式
mysql> shutdown
cd /usr/local/mysql/support-files      执行：./mysql.server stop


创建账户:create user '用户名'@'访问主机' identified by '密码';
赋予权限:grant 权限列表 on 数据库 to '用户名'@'访问主机' ;(修改权限时在后面加with grant option)




